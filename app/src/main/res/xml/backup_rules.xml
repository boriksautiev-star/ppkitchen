<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила Auto Backup для Android 11 (API 30) и ниже.
  Указываем, что бэкапить в Google Drive при переустановке.
-->
<full-backup-content>
    <!-- База данных — включаем -->
    <include domain="database" path="." />

    <!-- Настройки (SharedPreferences) — включаем -->
    <include domain="sharedpref" path="." />

    <!-- Приватные файлы (наш бэкап настроек) — включаем -->
    <include domain="file" path="." />
</full-backup-content>